+#[cfg(all(test, feature = "any"))]
+mod underflow_tests {
+    use super::*;
+    use crate::any::{
+        Any, AnyArguments, AnyConnectOptions, AnyConnection, AnyConnectionBackend, AnyQueryResult, AnyRow,
+        AnyStatement, AnyTypeInfo,
+    };
+    use crate::pool::Pool;
+    use crate::sql_str::SqlStr;
+    use either::Either;
+    use futures_core::future::BoxFuture;
+    use futures_core::stream::BoxStream;
+    use std::str::FromStr;
+    use std::thread;
+
+    #[derive(Debug)]
+    struct StubBackend;
+
+    impl AnyConnectionBackend for StubBackend {
+        fn name(&self) -> &str {
+            "stub"
+        }
+
+        fn close(self: Box<Self>) -> BoxFuture<'static, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn close_hard(self: Box<Self>) -> BoxFuture<'static, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn ping(&mut self) -> BoxFuture<'_, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn begin(&mut self, _statement: Option<SqlStr>) -> BoxFuture<'_, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn commit(&mut self) -> BoxFuture<'_, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn rollback(&mut self) -> BoxFuture<'_, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn start_rollback(&mut self) {}
+
+        fn shrink_buffers(&mut self) {}
+
+        fn flush(&mut self) -> BoxFuture<'_, crate::Result<()>> {
+            Box::pin(async { Ok(()) })
+        }
+
+        fn should_flush(&self) -> bool {
+            false
+        }
+
+        fn fetch_many(
+            &mut self,
+            _query: SqlStr,
+            _persistent: bool,
+            _arguments: Option<AnyArguments>,
+        ) -> BoxStream<'_, crate::Result<Either<AnyQueryResult, AnyRow>>> {
+            Box::pin(futures_util::stream::empty())
+        }
+
+        fn fetch_optional(
+            &mut self,
+            _query: SqlStr,
+            _persistent: bool,
+            _arguments: Option<AnyArguments>,
+        ) -> BoxFuture<'_, crate::Result<Option<AnyRow>>> {
+            Box::pin(async { Ok(None) })
+        }
+
+        fn prepare_with<'c, 'q: 'c>(
+            &'c mut self,
+            _sql: SqlStr,
+            _parameters: &[AnyTypeInfo],
+        ) -> BoxFuture<'c, crate::Result<AnyStatement>> {
+            Box::pin(async { Err(crate::Error::Configuration("unused stub backend".into())) })
+        }
+
+        #[cfg(feature = "offline")]
+        fn describe(
+            &mut self,
+            _sql: SqlStr,
+        ) -> BoxFuture<'_, crate::Result<crate::describe::Describe<Any>>> {
+            Box::pin(async { Err(crate::Error::Configuration("unused stub backend".into())) })
+        }
+    }
+
+    fn live_connection(inner: &Arc<PoolInner<Any>>) -> Floating<Any, Live<Any>> {
+        inner.size.fetch_add(1, Ordering::AcqRel);
+        let permit = inner.semaphore.try_acquire(1).expect("pool permit available");
+        let guard = DecrementSizeGuard::from_permit(Arc::clone(inner), permit);
+        Floating::new_live(
+            AnyConnection {
+                backend: Box::new(StubBackend),
+            },
+            guard,
+        )
+    }
+
+    #[test]
+    fn concurrent_release_and_acquire_never_underflows_idle_count() {
+        const MAX_CONNECTIONS: u32 = 3;
+        const WORKERS: usize = 12;
+        const ITERATIONS: usize = 200_000;
+
+        let options = AnyConnectOptions::from_str("stub::memory:").expect("parse connection options");
+        let pool: Pool<Any> = PoolOptions::new()
+            .max_connections(MAX_CONNECTIONS)
+            .min_connections(0)
+            .max_lifetime(None)
+            .idle_timeout(None)
+            .connect_lazy_with(options);
+        let inner = Arc::clone(&pool.0);
+        for _ in 0..MAX_CONNECTIONS {
+            inner.release(live_connection(&inner));
+        }
+        assert_eq!(inner.num_idle(), MAX_CONNECTIONS as usize);
+
+        let max_seen = Arc::new(AtomicUsize::new(0));
+        let mut workers = Vec::new();
+        for _ in 0..WORKERS {
+            let inner = Arc::clone(&inner);
+            let max_seen = Arc::clone(&max_seen);
+            workers.push(thread::spawn(move || {
+                for _ in 0..ITERATIONS {
+                    if let Some(idle) = inner.try_acquire() {
+                        inner.release(idle.into_live());
+                    }
+                    max_seen.fetch_max(inner.num_idle(), Ordering::Relaxed);
+                }
+            }));
+        }
+        for worker in workers {
+            worker.join().expect("worker thread joins");
+        }
+
+        let observed = max_seen.load(Ordering::Relaxed);
+        assert!(observed <= MAX_CONNECTIONS as usize, "observed {observed} idle connections");
+        while inner.try_acquire().is_some() {}
+    }
+}
