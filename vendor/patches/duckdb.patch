+unsafe fn time_tz_column_to_array(chunk: ffi::duckdb_data_chunk, column: usize, len: usize) -> Result<ArrayRef> {
+    let ptr = unsafe { ffi::duckdb_data_chunk_get_vector(chunk, column as u64) };
+    if ptr.is_null() {
+        return Err(duckdb_failure_from_message(format!(
+            "Could not retrieve DuckDB TIME_TZ vector at column {column}"
+        )));
+    }
+    // SAFETY: the caller holds the fetched chunk for the full conversion.
+    let vector = unsafe { FlatVector::from_raw(ptr) };
+    if len > vector.capacity() {
+        return Err(duckdb_failure_from_message(format!(
+            "DuckDB TIME_TZ row count {len} exceeds vector capacity {}",
+            vector.capacity()
+        )));
+    }
+    let values = (0..len)
+        .map(|row| {
+            if vector.try_row_is_null(row as u64)? {
+                Ok(None)
+            } else {
+                // SAFETY: DuckDB reports this row non-null; TIME_TZ is stored
+                // as duckdb_time_tz, and the capacity check bounds the slot.
+                let value = unsafe { vector.as_mut_ptr::<duckdb_time_tz>().add(row).read() };
+                Ok(Some(time_tz_to_string(value)))
+            }
+        })
+        .collect::<Result<Vec<_>>>()?;
+    Ok(Arc::new(StringArray::from(values)))
+}
+
+struct FetchedChunk(ffi::duckdb_data_chunk);
+
+impl FetchedChunk {
+    fn take(mut self) -> ffi::duckdb_data_chunk {
+        std::mem::replace(&mut self.0, std::ptr::null_mut())
+    }
+}
+
+impl Drop for FetchedChunk {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { ffi::duckdb_destroy_data_chunk(&mut self.0) }
+        }
+    }
+}
