{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookiE UI prototype",
  "version": "0.1.0",
  "identifier": "com.bookie.prototype",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "BookiE UI prototype", "width": 1100, "height": 800, "minWidth": 500, "minHeight": 400 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
