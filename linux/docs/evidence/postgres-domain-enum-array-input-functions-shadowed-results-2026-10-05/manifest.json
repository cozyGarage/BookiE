  "scenario": {
    "test": "value_contract_domain_enum_array_functions_infer_first_array_parameter_under_shadowed_path",
    "functions": [
      "array_position",
      "array_remove"
    ],
    "assertions": [
      "A same-named shadow enum leads transaction search_path while the target enum and table remain schema-qualified.",
      "The first array parameter is inferred as the target enum array from the typed enum element argument.",
      "array_position and array_remove results match explicitly typed native array oracles.",
      "array_send parameter bytes match native arrays, including an array with lower bound zero.",
      "Empty arrays, SQL NULL arrays, NULL elements and a literal NULL enum label are distinct cases.",
      "A label present only in the shadow enum is rejected with SQLSTATE 22P02 for both functions."
    ]
  },
