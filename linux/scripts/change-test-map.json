        "sql_dialect::tests::postgres_array_cast_tests::postgres_array_update_casts_allowlist_type_metadata",
        "sql_dialect::tests::postgres_domain_cast_tests::postgres_wide_numeric_updates_cast_text_to_the_builtin_numeric_type",
        "sql_dialect::tests::postgres_numeric_cast_does_not_interpolate_untrusted_metadata",
