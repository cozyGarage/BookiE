        "ui::browse_tab::row_ops::row_identity_tests::duplicating_a_row_refuses_an_undecodable_cell_instead_of_turning_it_into_null",
        "ui::browse_tab::row_ops::row_identity_tests::duplicating_a_row_carries_the_full_long_text_into_the_insert_not_the_display_text",
