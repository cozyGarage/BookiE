{
  "schema_version": 1,
  "groups": {
    "direct": {
      "bin": ["bookie-app"],
      "lib": ["bookie-app", "bookie-app-services", "bookie-core", "bookie-driver-clickhouse", "bookie-driver-sqlite", "bookie-policy"],
      "test": ["bookie-app", "bookie-core", "bookie-driver-postgres", "bookie-driver-sqlite", "bookie-policy"]
    },
    "sandbox": {
      "bin": ["bookie-agentd", "bookie-ssh"]
    },
    "consumers": {
      "bin": ["bookie-app"],
      "lib": ["bookie-app", "bookie-mcp", "bookie-policy"],
      "test": ["bookie-app", "bookie-mcp", "bookie-policy"]
    },
    "driver-core": {
      "test": ["bookie-app-services", "bookie-dump", "bookie-driver-mssql", "bookie-driver-mysql", "bookie-driver-postgres"]
    },
    "driver-analytics": {
      "test": ["bookie-driver-clickhouse", "bookie-driver-mongodb", "bookie-driver-redis"]
    },
    "driver-extended": {
      "test": ["bookie-driver-cassandra", "bookie-driver-duckdb", "bookie-driver-oracle", "bookie-policy"]
    },
    "drivers": {
      "test": [
        "bookie-driver-cassandra", "bookie-driver-clickhouse", "bookie-driver-duckdb",
        "bookie-driver-mssql", "bookie-driver-mongodb", "bookie-driver-mysql",
        "bookie-driver-oracle", "bookie-driver-postgres", "bookie-driver-redis",
        "bookie-dump", "bookie-app-services"
      ]
    },
    "pg-release": {
      "bin": ["bookie-agentd", "bookie-app", "bookie-ssh"],
      "lib": ["bookie-release-tests"],
      "test": ["bookie-agentd", "bookie-release-tests"]
    },
    "socket-ssh": {
      "bin": ["bookie-agentd", "bookie-ssh"],
      "test": ["bookie-agentd", "bookie-driver-postgres", "bookie-ssh"]
    },
    "driver-tls": {
      "lib": ["bookie-driver-tls-tests"],
      "test": ["bookie-driver-tls-tests"]
    },
    "keyring": {
      "bin": ["bookie-agentd"],
      "lib": ["bookie-app-services", "bookie-storage", "bookie-transport"],
      "test": ["bookie-agentd"]
    }
  },
  "providers": {
    "github": ["direct", "consumers", "driver-core", "driver-analytics", "driver-extended", "pg-release", "socket-ssh", "driver-tls", "keyring"],
    "forgejo": ["direct", "consumers", "driver-core", "driver-analytics", "driver-extended", "pg-release", "socket-ssh", "driver-tls", "keyring"]
  }
}
